# Copy to .env.local (APP_ENV=local reads .env.<APP_ENV> in apps/api). Empty value = unset.
APP_ENV=local
SERVICE_NAME=api
# LOG_LEVEL=DEBUG                    # default: production INFO, else DEBUG
# production: required, comma list, '*' rejected
ALLOWED_ORIGINS=*
# dev · qa · production: must not be the default 'admin'
DOCS_USER=admin
DOCS_PASSWORD=admin

DATABASE_URL=sqlite+aiosqlite:///./database.sqlite
# Postgres: uv add --package api asyncpg, then postgresql+asyncpg://user:pass@host/db
# DB_MIGRATE_ON_START=true           # default: not production

ANTHROPIC_API_KEY=
AGENT_BACKEND=messages               # messages | agent_sdk | managed
# AGENT_MODEL=claude-opus-5-5
# SUBAGENT_MODEL=claude-haiku-5-5
# MANAGED_ENVIRONMENT_NAME=agent-template
# RUN_TIMEOUT_SECONDS=600             # one run incl. subagents; stale running runs reaped at 2x
# AGENT_SDK_WORKDIR=/tmp/agent-sdk     # Agent SDK CLI cwd
